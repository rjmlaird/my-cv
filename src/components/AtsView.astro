---
// Plain, single-column CV for ATS parsers and clean printing. Rendered by src/pages/ats.astro.
// Conventional section order and plain headings so parsers recognise each block.
import api from "@/lib/api";
import { aggregateSkills, groupSkillsByCategory, type SkillSource } from "@/lib/skills";
import { formatDate, joinParts, toISODate } from "@/lib/format";

const [profile, experience, education, certifications, volunteering, memberships, awards, languages, socials] =
  await Promise.all([
    api.getProfile(),
    api.getExperience(),
    api.getEducation(),
    api.getCertifications(),
    api.getVolunteering(),
    api.getMemberships(),
    api.getAwards(),
    api.getLanguages(),
    api.getSocials(),
  ]);

type Located = {
  city?: string | null;
  country?: string | null;
  location?: { city?: string | null; country?: string | null } | string | null;
};
const getLoc = (item: Located) => {
  const loc = typeof item.location === "object" && item.location ? item.location : undefined;
  return joinParts([item.city || loc?.city, item.country || loc?.country], ", ");
};

const orgName = (o: unknown): string =>
  typeof o === "string" ? o : ((o as { name?: string } | null | undefined)?.name ?? "");

const byStartDesc = <T extends { startDate?: string | null }>(arr: T[]) =>
  [...arr].sort((a, b) => new Date(b.startDate ?? 0).getTime() - new Date(a.startDate ?? 0).getTime());

const range = (start?: string | null, end?: string | null, current?: boolean) =>
  joinParts([formatDate(start), current ? "Present" : formatDate(end)], " – ");

const sortedExp = byStartDesc(experience);
const sortedEdu = byStartDesc(education);
const sortedVol = byStartDesc(volunteering);

// Skills grouped by category as keyword lines.
const sources: SkillSource[] = [
  ...experience.map((r) => ({ tags: r.skills ?? [], ref: { label: r.role, href: "" } })),
  ...education.map((e) => ({ tags: e.skills ?? [], ref: { label: e.qualification || "", href: "" } })),
];
const skillGroups = groupSkillsByCategory(await aggregateSkills(sources));

const certsByIssuer = certifications.reduce<Record<string, string[]>>((acc, c) => {
  const key = c.issuer || "Other";
  (acc[key] ??= []).push(joinParts([c.name, c.level ? `(${c.level})` : ""], " "));
  return acc;
}, {});

const membershipLines = memberships.flatMap((g) =>
  g.items.map((i) => joinParts([i.organisation, i.role], " — ")),
);

const linkedin = socials.find((s) => /linkedin/i.test(s.name) || /linkedin\.com/i.test(s.url));
const website = profile?.portfolioLinks?.find((l) => /rjmlaird\.co\.uk/.test(l.href));
const contact = [
  profile?.location,
  profile?.email,
  linkedin?.url.replace(/^https?:\/\/(www\.)?/, ""),
  website?.href.replace(/^https?:\/\/(www\.)?/, ""),
].filter(Boolean) as string[];
const summary = profile?.summary?.length ? profile.summary : (profile?.biography ?? []);
---

<main id="main-content" class="ats-view">
  <header class="ats-header">
    <h1>{profile?.name ?? "Ryan Laird"}</h1>
    {profile?.role && <p class="ats-title">{profile.role}</p>}
    {profile?.credentials && <p class="ats-creds">{profile.credentials}</p>}
    {contact.length > 0 && (
      <ul class="ats-contact" aria-label="Contact details">
        {contact.map((c) => (
          <li>
            {c.includes("@") ? <a href={`mailto:${c}`}>{c}</a> : /\./.test(c) && !/\s/.test(c) ? <a href={`https://${c}`}>{c}</a> : c}
          </li>
        ))}
      </ul>
    )}
  </header>

  {summary.length > 0 && (
    <section aria-labelledby="ats-summary">
      <h2 id="ats-summary">Professional Summary</h2>
      {summary.map((p) => <p>{p}</p>)}
    </section>
  )}

  {skillGroups.length > 0 && (
    <section aria-labelledby="ats-skills">
      <h2 id="ats-skills">Core Skills</h2>
      <ul class="ats-plain">
        {skillGroups.map((g) => (
          <li><strong>{g.category}:</strong> {g.skills.map((s) => s.label).join(", ")}</li>
        ))}
      </ul>
    </section>
  )}

  {sortedExp.length > 0 && (
    <section aria-labelledby="ats-experience">
      <h2 id="ats-experience">Professional Experience</h2>
      {sortedExp.map((exp) => (
        <article class="ats-entry">
          <div class="ats-entry-head">
            <h3>{exp.role}</h3>
            <p class="ats-dates">
              <time datetime={toISODate(exp.startDate)}>{formatDate(exp.startDate)}</time>
              {" – "}
              {exp.current ? "Present" : <time datetime={toISODate(exp.endDate)}>{formatDate(exp.endDate)}</time>}
            </p>
          </div>
          <p class="ats-sub">{joinParts([orgName(exp.organisation), exp.department, getLoc(exp), exp.employmentType], " | ")}</p>
          {exp.summary && <p>{exp.summary}</p>}
          {exp.responsibilities.length > 0 && (
            <ul>{exp.responsibilities.map((r) => <li>{r}</li>)}</ul>
          )}
          {exp.achievements.length > 0 && (
            <>
              <p class="ats-label">Key achievements</p>
              <ul>{exp.achievements.map((a) => <li>{a}</li>)}</ul>
            </>
          )}
          {exp.technologies.length > 0 && (
            <p class="ats-label-inline"><strong>Technologies:</strong> {exp.technologies.join(", ")}</p>
          )}
        </article>
      ))}
    </section>
  )}

  {sortedEdu.length > 0 && (
    <section aria-labelledby="ats-education">
      <h2 id="ats-education">Education</h2>
      {sortedEdu.map((edu) => (
        <article class="ats-entry">
          <div class="ats-entry-head">
            <h3>{joinParts([edu.qualification, edu.field], " — ")}</h3>
            <p class="ats-dates">{range(edu.startDate, edu.endDate, edu.current)}</p>
          </div>
          <p class="ats-sub">{joinParts([edu.institution, getLoc(edu)], " | ")}</p>
        </article>
      ))}
    </section>
  )}

  {Object.keys(certsByIssuer).length > 0 && (
    <section aria-labelledby="ats-certs">
      <h2 id="ats-certs">Certifications</h2>
      <ul class="ats-plain">
        {Object.entries(certsByIssuer).map(([issuer, names]) => (
          <li><strong>{issuer}:</strong> {names.join("; ")}</li>
        ))}
      </ul>
    </section>
  )}

  {membershipLines.length > 0 && (
    <section aria-labelledby="ats-memberships">
      <h2 id="ats-memberships">Professional Memberships</h2>
      <ul>{membershipLines.map((m) => <li>{m}</li>)}</ul>
    </section>
  )}

  {awards.length > 0 && (
    <section aria-labelledby="ats-awards">
      <h2 id="ats-awards">Awards and Recognition</h2>
      <ul>
        {awards.map((a) => (
          <li>{joinParts([a.title, Array.isArray(a.issuer) ? a.issuer.join(", ") : a.issuer, String(a.year)], " — ")}</li>
        ))}
      </ul>
    </section>
  )}

  {sortedVol.length > 0 && (
    <section aria-labelledby="ats-volunteering">
      <h2 id="ats-volunteering">Volunteering</h2>
      {sortedVol.map((v) => (
        <article class="ats-entry">
          <div class="ats-entry-head">
            <h3>{v.role}</h3>
            <p class="ats-dates">{range(v.startDate, v.endDate, v.current)}</p>
          </div>
          <p class="ats-sub">{joinParts([v.organisation, getLoc(v)], " | ")}</p>
        </article>
      ))}
    </section>
  )}

  {languages.length > 0 && (
    <section aria-labelledby="ats-languages">
      <h2 id="ats-languages">Languages</h2>
      <p>{languages.map((l) => `${l.name} (${l.level})`).join("; ")}</p>
    </section>
  )}
</main>

<style>
  .ats-view {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 4rem;
    background: #fff;
    color: #111;
    font-family: Arial, Helvetica, "Segoe UI", system-ui, sans-serif;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  :global(body:has(.ats-view)) {
    background: #fff;
    color: #111;
  }

  .ats-header {
    display: block;
    padding: 0 0 0.75rem;
    border: 0;
    border-bottom: 2px solid #111;
  }
  /* One plain font throughout; undo the site's display font and global section/list styling. */
  h1,
  h2,
  h3 {
    font-family: inherit;
    letter-spacing: normal;
  }
  .ats-view section {
    padding: 0;
    border: 0;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.7rem, 5vw, 2.1rem);
    line-height: 1.15;
    color: #111;
  }
  .ats-title {
    margin: 0.25rem 0 0;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .ats-creds {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    color: #333;
  }
  .ats-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1.1rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .ats-view section > h2,
  h2 {
    margin: 1.5rem 0 0.6rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid #111;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #111;
  }
  p {
    margin: 0.35rem 0;
    color: #1a1a1a;
  }
  a {
    color: #0a4f9c;
  }

  .ats-entry {
    margin: 0 0 1.15rem;
    break-inside: avoid;
  }
  .ats-entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.1rem 1rem;
  }
  h3 {
    margin: 0;
    font-size: 1rem;
    color: #111;
  }
  .ats-dates {
    margin: 0;
    font-size: 0.88rem;
    color: #333;
    white-space: nowrap;
  }
  .ats-sub {
    margin: 0.1rem 0 0.4rem;
    color: #333;
    font-style: italic;
  }
  .ats-label {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .ats-label-inline {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
  }

  ul {
    margin: 0.3rem 0 0;
    padding-left: 1.2rem;
    list-style: disc;
  }
  li {
    margin: 0.2rem 0;
    color: #1a1a1a;
  }
  .ats-plain,
  .ats-header ul {
    padding-left: 0;
    list-style: none;
  }

  @media (max-width: 520px) {
    .ats-dates {
      white-space: normal;
    }
  }

  @media print {
    @page {
      margin: 14mm;
    }
    .ats-view {
      max-width: none;
      padding: 0;
      font-size: 10.5pt;
      line-height: 1.4;
    }
    a {
      color: #111;
      text-decoration: none;
    }
    h2 {
      break-after: avoid;
    }
    h3 {
      break-after: avoid;
    }
  }
</style>
