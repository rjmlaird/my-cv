---
import { CONTACT_EMAIL, PRIMARY_EMPLOYER } from "@/config/site";
---

<section id="contact" aria-labelledby="contact-heading">
  <div class="contact-cta">
    <div>
      <h2 id="contact-heading">Let's talk</h2>
      <p>Open to conversations on sustainable marketing, space sector communications, and science outreach.</p>
    </div>
    <div class="contact-links">
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      <a href="https://linkedin.com/in/rjmlaird87" target="_blank" rel="noopener">linkedin.com/in/rjmlaird87</a>
      <a href="https://github.com/rjmlaird" target="_blank" rel="noopener">github.com/rjmlaird</a>
      <a href={PRIMARY_EMPLOYER.url} target="_blank" rel="noopener">{PRIMARY_EMPLOYER.url.replace("https://", "")}</a>
    </div>
  </div>
</section>