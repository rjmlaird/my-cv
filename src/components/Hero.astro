---
import type { Profile } from "@/lib/api";

interface Props {
  profile: Profile | null;
}

const { profile } = Astro.props;

const name = profile?.name ?? "Ryan Laird";
const credentials = profile?.credentials ?? "";
// `biography` defaults to [] (never nullish), so check length rather than using `??`.
const summary = profile?.biography?.length ? profile.biography : (profile?.summary ?? []);
const tags = profile?.tags ?? [];
const portfolioLinks = profile?.portfolioLinks ?? [];
const headline = profile?.headline ?? "";
const location = profile?.location ?? "";
const email = profile?.email ?? "";

const escapeHtml = (s: string) =>
  s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string);

// Emphasise the employer name; the rest of the role string is escaped before it reaches set:html.
const roleHtml = profile?.role
  ? escapeHtml(profile.role).replace("Green Orbit Digital", "<strong>Green Orbit Digital</strong>")
  : "";
---

<section class="hero" aria-labelledby="hero-heading">
  <svg class="orbit-decor" viewBox="0 0 150 150" aria-hidden="true" focusable="false">
    <circle cx="75" cy="75" r="70" fill="none" stroke="#2dd4bf" stroke-opacity="0.25" stroke-width="1" />
    <circle cx="75" cy="75" r="48" fill="none" stroke="#f2b544" stroke-opacity="0.2" stroke-width="1" stroke-dasharray="3 5" />
    <circle cx="75" cy="5" r="3.5" fill="#2dd4bf" />
    <circle cx="123" cy="75" r="2.5" fill="#f2b544" />
  </svg>

  <div class="hero-inner">
    <p class="hero-eyebrow">Curriculum Vitae</p>
    <h1 id="hero-heading">{name}</h1>

    {headline && <p class="hero-headline">{headline}</p>}
    {roleHtml && <p class="hero-role" set:html={roleHtml} />}
    {credentials && <p class="hero-credentials">{credentials}</p>}

    {(location || email) && (
      <p class="hero-meta">
        {location}
        {location && email && <span aria-hidden="true"> · </span>}
        {email && <a href={`mailto:${email}`}>{email}</a>}
      </p>
    )}

    <div class="hero-actions">
      <a class="hero-btn hero-btn--primary" href={email ? `mailto:${email}` : "#contact"}>Get in touch</a>
      <a class="hero-btn" href="/ats/">ATS version</a>
      <button class="hero-btn" type="button" data-print>Download / Print</button>
    </div>

    <div class="hero-summary">
      {summary.map((p) => <p>{p}</p>)}
    </div>

    {portfolioLinks.length > 0 && (
      <nav class="hero-links" aria-label="Elsewhere on the web">
        <span class="hero-links-label" aria-hidden="true">Elsewhere</span>
        {portfolioLinks.map((link) => (
          <a class="hero-btn hero-btn--ghost" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}<span class="visually-hidden"> (opens in a new tab)</span><span aria-hidden="true"> ↗</span>
          </a>
        ))}
      </nav>
    )}

    {tags.length > 0 && (
      <ul class="hero-tags" aria-label="Core competencies">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    max-width: var(--maxw);
    margin: 0 auto 2rem;
    padding: clamp(1.75rem, 5vw, 4rem) 1.25rem 2rem;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
  }
  .orbit-decor {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 0;
    width: 140px;
    height: 140px;
    opacity: 0.35;
    pointer-events: none;
  }
  @media (max-width: 720px) {
    .orbit-decor {
      display: none;
    }
  }

  .hero-eyebrow {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal);
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .hero-headline {
    margin: 0.6rem 0 0;
    font-size: clamp(1.05rem, 2.6vw, 1.3rem);
    font-weight: 600;
    color: var(--muted);
  }
  .hero-role {
    margin: 0.5rem 0 0;
    font-size: 1.02rem;
    color: var(--muted);
  }
  .hero-role :global(strong) {
    color: var(--text);
  }
  .hero-credentials {
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--amber);
  }
  .hero-meta {
    margin: 0.75rem 0 0;
    font-size: 0.92rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .hero-meta a {
    color: var(--teal);
  }

  /* ---- Buttons ---- */
  .hero-actions,
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .hero-actions {
    margin-top: 1.5rem;
  }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3em;
    min-height: 44px;
    padding: 0.6rem 1.2rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .hero-btn:hover {
    border-color: var(--teal);
    color: var(--teal);
    text-decoration: none;
  }
  .hero-btn:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .hero-btn--primary {
    border-color: var(--teal);
    background: var(--teal);
    color: #04211d;
  }
  .hero-btn--primary:hover {
    border-color: #25b8a4;
    background: #25b8a4;
    color: #04211d;
  }
  .hero-btn--ghost {
    font-weight: 500;
    font-size: 0.84rem;
    border-color: var(--border);
    color: var(--muted);
  }

  /* ---- Introduction: full width of the content column ---- */
  .hero-summary {
    max-width: none;
    margin-top: 1.75rem;
  }
  .hero-summary p {
    margin: 0 0 1rem;
    font-size: clamp(1rem, 1.4vw, 1.1rem);
    line-height: 1.7;
    color: var(--muted);
  }
  .hero-summary p:first-child {
    color: var(--text);
  }

  .hero-links {
    margin-top: 0.5rem;
  }
  .hero-links-label {
    margin-right: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-dim);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-tags li {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 560px) {
    .hero-actions .hero-btn {
      flex: 1 1 100%;
    }
    .hero-links-label {
      flex: 1 1 100%;
    }
    .hero-links .hero-btn {
      flex: 1 1 calc(50% - 0.3rem);
    }
  }

  @media print {
    .hero-actions,
    .hero-links {
      display: none;
    }
  }
</style>
