---
import { navLinks } from "@/data/nav";
---

<header class="site-header" id="site-header">
  <div class="site-header-inner">
    <a class="nav-name" href="/" aria-label="Ryan Laird, home">Ryan <span>Laird</span></a>

    <button
      id="menu-toggle"
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-panel"
      aria-label="Open menu"
    >
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav class="nav-panel" id="nav-panel" aria-label="Sections">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>

      <div class="nav-actions">
        <a class="nav-btn" href="/ats/">ATS view</a>
        <button class="nav-btn nav-btn--primary" type="button" data-print>Download / Print</button>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
  const panel = document.getElementById("nav-panel");
  const desktop = window.matchMedia("(min-width: 1180px)");

  const setOpen = (open: boolean) => {
    if (!toggle || !panel) return;
    panel.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (open) header?.classList.remove("nav-hidden");
  };
  const isOpen = () => toggle?.getAttribute("aria-expanded") === "true";

  toggle?.addEventListener("click", () => setOpen(!isOpen()));

  // Close after choosing a link, on Escape (returning focus), on outside click, and when widening to desktop.
  panel?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a, button")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });
  document.addEventListener("click", (e) => {
    if (isOpen() && header && !header.contains(e.target as Node)) setOpen(false);
  });
  desktop.addEventListener("change", () => setOpen(false));

  // Hide on scroll down, reveal on scroll up (never while the menu is open).
  let lastScroll = 0;
  window.addEventListener(
    "scroll",
    () => {
      const current = window.scrollY;
      if (!isOpen() && current > lastScroll && current > 120) header?.classList.add("nav-hidden");
      else header?.classList.remove("nav-hidden");
      lastScroll = current;
    },
    { passive: true },
  );

  // Any element marked data-print opens the print dialog (hero button, menu button).
  document.querySelectorAll("[data-print]").forEach((el) => el.addEventListener("click", () => window.print()));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: block;
    padding: 0;
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transition: transform 0.25s ease;
  }
  .site-header.nav-hidden {
    transform: translateY(-100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }

  .site-header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--maxw);
    min-height: 60px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .nav-name {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--text);
    text-decoration: none;
  }
  .nav-name span {
    color: var(--teal);
  }

  /* ---- Hamburger (mobile first) ---- */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -0.5rem;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .menu-toggle:focus-visible,
  .nav-list a:focus-visible,
  .nav-btn:focus-visible,
  .nav-name:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .bars {
    position: relative;
  }
  .bars::before,
  .bars::after {
    content: "";
    position: absolute;
    left: 0;
  }
  .bars::before {
    top: -7px;
  }
  .bars::after {
    top: 7px;
  }
  .menu-toggle[aria-expanded="true"] .bars {
    background: transparent;
  }
  .menu-toggle[aria-expanded="true"] .bars::before {
    top: 0;
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .nav-panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - 60px);
    overflow-y: auto;
    padding: 0.5rem 1rem 1.25rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.35);
  }
  .nav-panel.open {
    display: block;
  }

  .nav-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-list a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 0.25rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }
  .nav-list a:hover {
    color: var(--teal);
  }

  .nav-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .nav-btn {
    display: inline-flex;
    flex: 1 1 9rem;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .nav-btn:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .nav-btn--primary {
    border-color: orange;
    background: orange;
    color: #0a0f1a; /* 10:1 on orange; white was 1.97:1 */
  }
  .nav-btn--primary:hover {
    color: #0a0f1a;
    filter: brightness(1.06);
  }

  /* ---- Desktop: inline links, no hamburger ---- */
  @media (min-width: 1180px) {
    .site-header-inner {
      padding: 0 1.5rem;
    }
    .menu-toggle {
      display: none;
    }
    .nav-panel {
      display: flex;
      position: static;
      flex: 1;
      align-items: center;
      justify-content: flex-end;
      max-height: none;
      overflow: visible;
      padding: 0;
      background: transparent;
      border: 0;
      box-shadow: none;
    }
    .nav-list {
      display: flex;
      gap: 0.1rem;
    }
    .nav-list a {
      min-height: 44px;
      padding: 0 0.6rem;
      border: 0;
      border-radius: 999px;
      font-size: 0.8rem;
      letter-spacing: 0.03em;
      color: var(--muted);
      white-space: nowrap;
    }
    /* The desktop bar has no room for these; the hero carries them. They stay in the mobile menu. */
    .nav-actions {
      display: none;
      margin: 0 0 0 1rem;
    }
  }
</style>
