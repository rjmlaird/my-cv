---
// Plain-text, single-column CV for ATS parsers and clean printing.
// Deliberately noindex and excluded from the sitemap: the visual CV at "/" is the canonical page.
import Layout from "@/layouts/Layout.astro";
import AtsView from "@/components/AtsView.astro";
---

<Layout
  title="Ryan Laird — CV (plain-text / ATS version)"
  description="Plain-text, single-column version of Ryan Laird's CV, formatted for applicant tracking systems and printing."
  noindex
  canonicalPath="/"
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <nav class="ats-actions" aria-label="CV view options">
    <a class="ats-btn" href="/">← Visual CV</a>
    <button class="ats-btn ats-btn--solid" type="button" data-print>Print / save as PDF</button>
  </nav>
  <AtsView />
</Layout>

<script>
  document.querySelectorAll("[data-print]").forEach((el) => el.addEventListener("click", () => window.print()));
</script>

<style>
  .ats-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    max-width: 820px;
    margin: 0 auto;
    padding: 1rem 1.25rem 0;
  }
  .ats-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border: 1px solid #111;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font: inherit;
    font-size: 0.9rem;
    text-decoration: none;
    cursor: pointer;
  }
  .ats-btn:hover {
    background: #f1f1f1;
  }
  .ats-btn--solid {
    background: #111;
    color: #fff;
  }
  .ats-btn--solid:hover {
    background: #333;
  }
  .ats-btn:focus-visible {
    outline: 3px solid #0a4f9c;
    outline-offset: 2px;
  }
  @media print {
    .ats-actions {
      display: none;
    }
  }
</style>
