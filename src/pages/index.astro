---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import Experience from "@/components/Experience.astro";
import Education from "@/components/Education.astro";
import Certifications from "@/components/Certifications.astro";
import Memberships from "@/components/Memberships.astro";
import Languages from "@/components/Languages.astro";
import Research from "@/components/Research.astro";
import Awards from "@/components/Awards.astro";
import Skills from "@/components/Skills.astro";
import Tools from '@/components/Tools.astro';
import Volunteering from "@/components/Volunteering.astro";
import Contact from "@/components/Contact.astro";
import Footer from "@/components/Footer.astro";
import api from "@/lib/api";
import { buildStructuredData } from "@/lib/structuredData";
import { getCdnUrl } from "@/lib/cdn";
import { SITE_URL } from "@/config/site";

// Fetch all data
const [
  profile,
  experience = [],
  education = [],
  certifications = [],
  membershipGroups = [],
  awards = [],
  languages = [],
  socials = [],
  tools = { categories: [] },
  volunteering = [],
  projects = [],
] = await Promise.all([
  // Critical data: these throw (failing the build) rather than shipping a blank CV.
  // See `critical()` in src/lib/api.ts. Set ALLOW_PARTIAL=1 to override locally.
  api.getProfile(),
  api.getExperience(),
  api.getEducation(),
  api.getCertifications().catch(() => []),
  api.getMemberships().catch(() => []),
  api.getAwards().catch(() => []),
  api.getLanguages().catch(() => []),
  api.getSocials().catch(() => []),
  api.getTools().catch(() => ({ categories: [] })),
  api.getVolunteering().catch(() => []),
  api.getProjects().catch(() => []),
]);

// Meta & Structured Data
const ogImageUrl = new URL("/og-image.png", SITE_URL).toString();
const avatarUrl = profile?.avatar?.startsWith("http") ? profile.avatar : await getCdnUrl(profile?.avatar);

const structuredData = buildStructuredData({
  profile,
  experience,
  socials,
  ogImageUrl,
  avatarUrl,
  dateModified: new Date().toISOString(),
});
---

<Layout structuredData={structuredData}>
  <Nav />
  
  <Hero profile={profile} />
  
  <main id="main-content" aria-label="CV content">
    <Experience experience={experience} />
    <Education education={education} />
    <Research socials={socials} />
    <Certifications certifications={certifications} />
    <Memberships memberships={membershipGroups} />
    <Languages languages={languages} />
    <Awards awards={awards} />
    <Skills />
    <Tools data={tools} />
    <Volunteering 
      volunteering={volunteering} 
      allProjects={projects} 
      allAwards={awards} 
    />
    <Contact profile={profile} socials={socials} />
  </main>

  <Footer />
</Layout>